
<%= simple_form_for current_company, html: { class: "company form" } do |f| %>
  <%= f.input :name %>
  <%= f.select :currency, common_currency_options %>
  <%= f.file_field :icon %>

  <% if f.object.icon.attached? %>
    <div class="icon-preview">
      <%= image_tag f.object.icon.variant(resize_to_limit: [100, 100]) %>
      <%= link_to "Remove", 
                  "",
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                  class: "text-red-500" %>
    </div>
  <% end %>

  <% ItemConfiguration.all.each do |item_configuration| %>
    <% company_item_config = current_company.company_item_configurations.find_by(name: item_configuration.name) %>

    <div class="mt-4">
      <h3 class="font-semibold"><%= item_configuration.name %></h3>
      <% if item_configuration.description.present? %>
        <p class="text-sm text-gray-600"><%= item_configuration.description %></p>
      <% end %>

      <div class="mt-2">
        <%= hidden_field_tag "company[version]", "draft" %>
        <%= hidden_field_tag "company[item_configurations][#{item_configuration.id}][name]", item_configuration.name %>

        <%= label_tag "company_item_configuration_#{item_configuration.id}_value", "Select option", class: "block text-sm font-medium text-gray-700" %>

        <%= select_tag "company[item_configurations][#{item_configuration.id}][value]",
                       options_for_select(
                         (item_configuration.options || []).map { |opt| [opt["value"], opt["value"]] },
                         company_item_config&.value
                       ),
                       include_blank: true,
                       id: "company_item_configuration_#{item_configuration.id}_value",
                       class: "mt-1 block w-full" %>
      </div>
    </div>
  <% end %>


  <div class="border-t pt-6 mt-8">
    <h2 class="text-lg font-bold">Payment Gateway</h2>
    <p class="text-sm text-gray-500 mb-4">Securely configure your payment credentials.</p>

    <%= f.simple_fields_for :payment_setting do |p| %>
      <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <%# Use the PROVIDERS constant from the model %>
          <%= p.input :provider, 
                      collection: PaymentSetting::PROVIDERS, 
                      prompt: "Select Provider",
                      label: "Payment Provider",
                      input_html: { class: "w-full rounded-md" } %>
        </div>

        <div class="mt-6 space-y-4">
          <h4 class="text-xs font-bold uppercase tracking-widest text-gray-400">Credentials</h4>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <%# api_key maps to Stripe's Publishable Key (pk_...) %>
            <%= p.input :api_key, 
                        label: "Public API Key", 
                        placeholder: "pk_test_...",
                        input_html: { class: "w-full" } %>

            <%# secret maps to Stripe's Secret Key (sk_test_...) %>
            <%= p.input :secret, 
                        label: "Secret Key", 
                        as: :password, # Ensures it's masked in the UI
                        placeholder: "sk_test_...",
                        input_html: { class: "w-full", value: p.object.secret } %>
          </div>
          <p class="text-xs text-gray-400 italic">
            Your keys are encrypted before being saved to our database.
          </p>
        </div>
      </div>
    <% end %>
  </div>



  <div class="form__actions form-stepper__navigation" >
    <%= f.button :submit, "Update Company", class: "btn btn--secondary" %>
  </div>
<% end %>