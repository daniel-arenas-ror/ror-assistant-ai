header.h-16.bg-white.border-b.border-gray-200.flex.items-center.justify-between.px-8.sticky.top-0.z-40
  .flex.items-center.gap-6
    - if user_signed_in?
      / Primary Navigation Links
      nav.flex.items-center.gap-1
        = link_to users_path, class: "px-3 py-2 text-sm font-medium text-gray-600 hover:text-black rounded-md hover:bg-gray-50 transition"
          | Users
        
        = link_to edit_company_path(current_company), class: "px-3 py-2 text-sm font-medium text-gray-600 hover:text-black rounded-md hover:bg-gray-50 transition"
          | Company
        
        = link_to conversations_path, class: "px-3 py-2 text-sm font-medium text-gray-600 hover:text-black rounded-md hover:bg-gray-50 transition"
          | Conversations
        
        = link_to leads_path, class: "px-3 py-2 text-sm font-medium text-gray-600 hover:text-black rounded-md hover:bg-gray-50 transition"
          | Leads

        - if current_company.assistant.present?
          = link_to edit_assistant_path(current_company.assistant), class: "px-3 py-2 text-sm font-medium text-gray-600 hover:text-black rounded-md hover:bg-gray-50 transition"
            = "Edit #{current_company.assistant_name}"
          
          = link_to new_public_conversation_path(assistant_id: current_company.assistant_slug), 
                    target: '_blank', 
                    class: "ml-2 px-3 py-1.5 text-sm font-semibold bg-rose-50 text-rose-600 rounded-full hover:bg-rose-100 transition flex items-center gap-2"
            i.lucide-external-link.w-3.h-3
            = "Chat con #{current_company.assistant_name}"

  .flex.items-center.gap-4
    - if user_signed_in?
      / User Profile and Sign Out
      .flex.items-center.gap-3.pr-4.border-r.border-gray-200
        .text-right
          p.text-sm.font-bold.text-gray-900.leading-none = current_user.name
          p.text-xs.text-gray-500.mt-1 Administrator
        
        .w-8.h-8.bg-gray-100.rounded-full.flex.items-center.justify-center.text-gray-500.font-bold.text-xs
          = current_user.name[0]

      = button_to destroy_user_session_path, 
                  method: :delete, 
                  class: "text-sm font-medium text-gray-500 hover:text-red-600 transition flex items-center gap-2"
        i.lucide-log-out.w-4.h-4
        span Sign out
    
    - else
      = link_to new_user_session_path, 
                  class: "bg-black text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-800 transition"
        | Sign in
