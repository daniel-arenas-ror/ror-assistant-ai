<%= simple_form_for option_type, html: { class: "option_type form" } do |f| %>
  <%= form_error_notification(option_type) %>

  <%= f.input :name, input_html: { autofocus: true }, required: true %>

  
  <% if f.object.persisted? %>
    <h3>Option Values</h3>
    <div id="option_values">
      <%= f.fields_for :option_values do |value_form| %>
        <%= render "option_value_fields", f: value_form %>
      <% end %>
    </div>
  <% end %>

  <%= link_to "Add Value", add_value_option_types_path, data: { turbo_stream: true }, class: "btn-secondary" %>

  <div class="form__actions">
    <%= link_to "Cancel", option_types_path, class: "btn btn--light" %>
    <%= f.submit class: "btn btn--secondary" %>
  </div>
<% end %>
