<div class="nested-fields" data-controller="nested-fields">
  <%= f.text_field :name, placeholder: "Value (e.g. Red)" %>
  <%= f.color_field :label, placeholder: "" %>
  
  <%# If editing, this allows deleting existing values %>
  <%= f.hidden_field :company_id %>
  <%= f.hidden_field :_destroy %>

  <a href="#" class="remove_fields" data-action="click->nested-fields#remove">Remove</a>
</div>
