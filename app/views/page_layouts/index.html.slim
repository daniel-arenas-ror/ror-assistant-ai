.max-w-6xl.mx-auto.px-4.py-10
  header.flex.justify-between.items-center.mb-10
    div
      h1.text-3xl.font-extrabold.text-gray-900 Page Layouts
      p.text-gray-500.mt-1 Manage your dynamic store pages and their components.
    
    = link_to new_page_layout_path, class: "btn-primary flex items-center gap-2 bg-black text-white px-5 py-2.5 rounded-lg hover:bg-gray-800 transition shadow-sm"
      i.lucide-plus.w-4.h-4
      span Create New Page

  .bg-white.rounded-xl.shadow-sm.border.border-gray-200.overflow-hidden
    table.min-w-full.divide-y.divide-gray-200
      thead.bg-gray-50
        tr
          th.px-6.py-4.text-left.text-xs.font-bold.text-gray-500.uppercase.tracking-widest Title
          th.px-6.py-4.text-left.text-xs.font-bold.text-gray-500.uppercase.tracking-widest Path
          th.px-6.py-4.text-left.text-xs.font-bold.text-gray-500.uppercase.tracking-widest Components
          th.px-6.py-4.text-left.text-xs.font-bold.text-gray-500.uppercase.tracking-widest Status
          th.px-6.py-4.text-right.text-xs.font-bold.text-gray-500.uppercase.tracking-widest Actions

      tbody.divide-y.divide-gray-200
        - @page_layouts.each do |layout|
          tr.hover:bg-gray-50.transition
            td.px-6.py-4
              .font-semibold.text-gray-900 = layout.title
              .text-xs.text-gray-400 = "Last updated #{time_ago_in_words(layout.updated_at)} ago"
            
            td.px-6.py-4
              code.text-sm.bg-gray-100.px-2.py-1.rounded.text-rose-600 = layout.path
            
            td.px-6.py-4
              span.inline-flex.items-center.px-2.5.py-0.5.rounded-full.text-xs.font-medium.bg-blue-100.text-blue-800
                = "#{layout.page_components.count} Blocks"
            
            td.px-6.py-4
              - if layout.published?
                span.flex.items-center.gap-1.text-green-600
                  .w-2.h-2.bg-green-600.rounded-full
                  span.text-sm.font-medium Published
              - else
                span.flex.items-center.gap-1.text-gray-400
                  .w-2.h-2.bg-gray-400.rounded-full
                  span.text-sm.font-medium Draft

            td.px-6.py-4.text-right.space-x-3
              = link_to edit_page_layout_path(layout), class: "text-blue-600 hover:text-blue-900 font-medium text-sm"
                | Edit
              
              / Link to the React Preview (using the ?version=draft flag we discussed!)
              = link_to "Preview", "#{root_url}#{layout.path}?version=draft", target: "_blank", class: "text-gray-600 hover:text-black font-medium text-sm"

              = link_to page_layout_path(layout), data: { turbo_method: :delete, turbo_confirm: "Delete this page?" }, class: "text-red-600 hover:text-red-900 font-medium text-sm"
                | Delete

    - if @page_layouts.empty?
      .p-20.text-center
        .text-gray-400.mb-4 No pages created yet.
        = link_to "Get Started", new_page_layout_path, class: "text-blue-600 underline"
