<%= simple_form_for product, html: { class: "product form" } do |f| %>

  <div class="form-stepper" data-controller="tabs">
    <!-- 1. Stepper Header (The Tabs) -->
    <div class="form-stepper__header">
      <div data-tabs-target="header" class="form-stepper__step" data-action="click->tabs#switch" data-step="1">
        <span class="form-stepper__step-number">1</span>
        <span class="form-stepper__step-label">Basic</span>
      </div>

      <div data-tabs-target="header" class="form-stepper__step" data-action="click->tabs#switch" data-step="2">
        <span class="form-stepper__step-number">2</span>
        <span class="form-stepper__step-label">Configuración</span>
      </div>

      <div data-tabs-target="header" class="form-stepper__step" data-action="click->tabs#switch" data-step="3">
        <span class="form-stepper__step-number">3</span>
        <span class="form-stepper__step-label">Variantes</span>
      </div>
    </div>

    <div class="form-stepper__content">
      <%= form_error_notification(product) %>

      <div data-tabs-target="body" class="form-stepper__content-pane form-stepper__content-pane--active" data-step-content="1">
        <h3>Step 1: Basic Details</h3>
        <p>Basic assistant details</p>

        <%= f.input :name, input_html: { autofocus: true } %>
        <%= f.input :code, input_html: { autofocus: true } %>
        <%= f.input :url, input_html: { autofocus: true } %>
        <%= f.input :description, input_html: { autofocus: true } %>
        <%= f.input :amenities, input_html: { autofocus: true } %>
        <%= f.input :location, input_html: { autofocus: true } %>
        <%= f.input :price, input_html: { autofocus: true } %>
        <%= f.input :active, input_html: { autofocus: true } %>

        <table class="table">
          <tbody>
            <% @current_company.categories.roots.each do |category| %>
              <tr>
                <td><%= link_to category.name, edit_category_path(category) %></td>
                <td><%= category.parent_category&.name %></td>
                <td>
                  <input class="form__input" type="checkbox" value="<%= category.id %>" <%= product.category_ids.include?(category.id) && "checked=\"checked\"" %> name="product[category_ids][]" id="product_category_ids_<%= category.id %>">
                </td>
              </tr>
              <% category.sub_categories.each do |sub| %>
                <tr>
                  <td style="padding-left:24px">— <%= link_to sub.name, category_path(sub) %></td>
                  <td><%= sub.parent_category&.name %></td>
                  <td>
                    <input class="form__input" type="checkbox" value="<%= sub.id %>" name="product[category_ids][]" id="product_category_ids_<%= sub.id %>" <%= product.category_ids.include?(sub.id) && "checked=\"checked\"" %>>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>

        <% f.object.images.each do |image| %>
          <%= f.hidden_field :images, multiple: true, value: image.signed_id %>
        <% end %>

        <%= f.file_field :images, multiple: true %>

        <div class="image-grid">
          <% f.object.images.each do |image| %>
            <div id="<%= dom_id(image) %>">
              <%= image_tag image.variant(:thumb) %>
              
              <%# Link to a custom delete action %>
              <%= link_to "Remove", 
                          purge_image_variant_path(f.object, image_id: image.id), 
                          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                          class: "text-red-500" %>
            </div>
          <% end %>
        </div>
      </div>

      <div data-tabs-target="body" class="form-stepper__content-pane" data-step-content="2">
        <h3>Step 2: Technical Configuration</h3>
        <p>Specify technical details like roles or conditions.</p>

        <% current_company.option_types.each do |option_type| %>
          <div class="field">
            <label><%= option_type.name %></label>
            <input class="form__input" type="checkbox" value="<%= option_type.id %>" name="product[product_option_types_attributes][][option_type_id]" id="product_product_option_types_attributes_<%= option_type.id %>" <%= product.option_types.include?(option_type) && "checked=\"checked\"" %>>
          </div>
        <% end %>
      </div>

      <div data-tabs-target="body" class="form-stepper__content-pane" data-step-content="3">
        <h3>Step 3: Variant Configuration</h3>
        <p>Specify technical details like roles or conditions.</p>

        <% if product.persisted? %>
          <div data-controller="nested-fields" data-nested-fields-list-target="list">
            <div data-nested-fields-target="list">
              <%= f.simple_fields_for :variants do |vf| %>
                <% next if vf.object.is_master? %>
                <%= render partial: 'variant_fields', locals: { f: vf, product: product } %>
              <% end %>
            </div>

            <template data-nested-fields-target="template">
              <%= f.simple_fields_for :variants, product.variants.build(company: product.company), child_index: 'NEW_RECORD' do |temp_form| %>
                <%= render partial: 'variant_fields', locals: { f: temp_form, product: product } %>
              <% end %>
            </template>

            <a href="#" data-action="click->nested-fields#add" class="btn">Add variant</a>
          </div>

          <% product&.url_images&.each do |url| %>
            <%= image_tag url, width: "200px" if url.present? %>
          <% end %>
        <% end %>
      </div>
  </div>

  <div class="form__actions form-stepper__navigation" >
    <%= link_to "Cancel", products_path, class: "btn btn--light" %>
    <% if !product.new_record? %>
      <%= link_to "Scrape Data",
          scrape_product_path(@product),
          data: { turbo_method: :patch, turbo_confirm: "Run scraper?" },
          class: "btn btn-warning"
      %>
    <% end %>
    <%= f.submit class: "btn btn--secondary" %>
  </div>
<% end %>
