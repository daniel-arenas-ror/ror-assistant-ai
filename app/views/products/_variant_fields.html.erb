
<tr class="nested-fields variant-fields">
  <%= f.hidden_field :company_id, value: product.company_id %>
  <%= f.hidden_field :_destroy, class: "destroy-flag" %>
  <td><%= f.input :sku %></td>
  <td><%= f.input :price %></td>
  <% product.option_types.each do |option_type| %>
    <td>
      <% child_index = (f.options[:child_index] || f.object.try(:id) || "NEW_RECORD") %>
      <% input_name = "product[variants_attributes][#{child_index}][option_value_ids][]" %>

      <%= select_tag input_name, 
            options_from_collection_for_select(
              option_type.option_values, 
              :id, 
              :name, 
              f.object.option_value_ids.find { |id| option_type.option_value_ids.include?(id) }
            ),
            include_blank: "Select #{option_type.name}...",
            class: "form__input"
      %>
    </td>
  <% end %>
  <td>
    <%= f.file_field :images, multiple: true %>
  </td>
  <td>
    <a href="#" data-action="click->nested-fields#remove" class="btn btn--danger">Eliminar</a>
  </td>
</tr>
