{
  "name": "app",
  "private": true,
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass ./app/assets/stylesheets/application.scss:/tmp/application.css --no-source-map --load-path=node_modules && tailwindcss -i /tmp/application.css -o ./app/assets/builds/application.css --watch=false"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.18",
    "@rails/actioncable": "^8.1.100"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "sass": "^1.97.3",
    "tailwindcss": "^4.2.4"
  }
}
